<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sap.Cloud.Sdk.DataModel.ODataV4.Generator\Sap.Cloud.Sdk.DataModel.ODataV4.Generator.csproj" />
    <!-- Generated code is compiled in memory against the runtime library in the tests. -->
    <ProjectReference Include="..\..\src\Sap.Cloud.Sdk.DataModel.ODataV4.Core\Sap.Cloud.Sdk.DataModel.ODataV4.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The golden test compares the generator output with the sample of the runtime library tests. -->
    <None Include="..\Sap.Cloud.Sdk.DataModel.ODataV4.Core.Tests\Sample\**" Link="Sample\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
